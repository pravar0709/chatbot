# === Lyftr Chatbot Environment Variables ===

# Comma-separated LLM API keys (at least 2 for failover)
LLM_API_KEYS=your-api-key-1,your-api-key-2

# LiteLLM model identifier
LLM_MODEL=gemini/gemini-3.5-flash

# SQLite database URL (path inside Docker container)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Enable X-Simulate-Failure header for testing failover
ENABLE_FAILURE_SIMULATION=true

# Default system prompt for new sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# LLM request timeout in seconds
LLM_TIMEOUT=30

# Backend server port
PORT=8000
